{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Machine Alert Message",
  "description": "Alert fired by edge rule engine or anomaly detection",
  "type": "object",
  "required": [
    "alert_id",
    "timestamp",
    "machine_id",
    "operator_id",
    "site_id",
    "rule",
    "severity",
    "message"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "pattern": "^AL[0-9]{5}$",
      "description": "Unique alert identifier"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp when alert fired"
    },
    "machine_id": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{3}$",
      "description": "Machine identifier"
    },
    "operator_id": {
      "type": "string",
      "pattern": "^OP[0-9]{4}$",
      "description": "Operator in the machine when alert fired"
    },
    "site_id": {
      "type": "string",
      "pattern": "^S[0-9]{2}$",
      "description": "Site identifier"
    },
    "rule": {
      "type": "string",
      "enum": [
        "UNBELTED_WHILE_MOVING",
        "PROXIMITY_WARNING",
        "PROXIMITY_CRITICAL",
        "EXCESSIVE_SPEED",
        "UNATTENDED_RUNNING",
        "COOLANT_OVERHEAT",
        "ABNORMAL_FUEL_BURN",
        "ABNORMAL_HYDRAULIC",
        "ABNORMAL_OPERATOR_BEHAVIOR",
        "LOW_BATTERY",
        "HARSH_EVENT"
      ],
      "description": "Rule or model that triggered the alert"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"],
      "description": "Alert severity level"
    },
    "message": {
      "type": "string",
      "maxLength": 256,
      "description": "Human-readable alert message (played via voice)"
    },
    "data": {
      "type": "object",
      "description": "Additional context (rule-specific)",
      "properties": {
        "value": {
          "type": "number",
          "description": "Current value that triggered alert"
        },
        "threshold": {
          "type": "number",
          "description": "Threshold that was exceeded"
        },
        "proximity_m": {
          "type": "number",
          "description": "For proximity alerts: nearest object distance"
        },
        "speed_kmh": {
          "type": "number",
          "description": "For speed alerts: current speed"
        }
      }
    }
  }
}
